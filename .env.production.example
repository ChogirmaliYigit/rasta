# ============================
# Rasta B2B Marketplace
# Production Environment
# ============================

# --- Domain & SSL ---
DOMAIN_NAME=your-domain.com
SSL_EMAIL=admin@your-domain.com

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=rasta_db_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here_32chars
POSTGRES_DB=rasta_db

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_here
REDIS_URL=redis://:CHANGE_ME_strong_redis_password_here@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password_here@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_strong_redis_password_here@redis:6379/2

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application ---
ENVIRONMENT=production
DEBUG=false
APP_NAME=Rasta B2B Marketplace API
API_V1_STR=/api/v1

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/webhook/telegram

# --- SMS Gateway ---
SMS_API_KEY=your-sms-api-key
SMS_API_URL=your-sms-api-url
